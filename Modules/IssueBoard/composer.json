{
    "name": "allocore/issue-board",
    "description": "Aufgabenboard fuer die interne Abstimmung zwischen Kunde, Ali und Entwicklung.",
    "type": "laravel-module",
    "require": {
        "php": "^8.2",
        "livewire/livewire": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\IssueBoard\\": "app/",
            "Modules\\IssueBoard\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\IssueBoard\\Providers\\IssueBoardServiceProvider"
            ]
        }
    }
}
